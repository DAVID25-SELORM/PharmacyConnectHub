VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SITE_URL=https://your-app.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SITE_URL=https://your-app.example.com

# Online payments (Pay now). Leave all of these unset to keep online payments off. Names only here: put the real values in the hosting
# provider's environment (never in the repository, never in a VITE_ variable, never in the browser).
# PAYMENTS_MODE=test
# PAYSTACK_SECRET_KEY=sk_test_...   (the key's prefix must match PAYMENTS_MODE; a live key in test mode is refused)
# PAYMENTS_LIVE_ENABLED=yes         (a second, explicit switch, only for live mode)
